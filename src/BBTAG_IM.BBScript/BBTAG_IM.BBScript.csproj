<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>BBTAG_IM.BBScript</RootNamespace>
    <AssemblyName>bbscript</AssemblyName>
    <Product>BBTAG BBScript tool</Product>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PlatformTarget>x86</PlatformTarget>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BBTAG_IM.Core\BBTAG_IM.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TesterBuild)' == 'true'">
    <Compile Remove="ScriptTool.Port.cs" />
  </ItemGroup>

</Project>
