<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>BBTAG_IM.Launcher</RootNamespace>
    <AssemblyName>BBTAG_Mod_Loader</AssemblyName>
    <Product>BBTAG Mod Loader</Product>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PlatformTarget>x86</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>..\..\resource\ModLoader\BBTAG_Mod_Loader.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BBTAG_IM.Core\BBTAG_IM.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\resource\ModLoader\BBTAG_Mod_Loader.ico" Link="Assets\BBTAG_Mod_Loader.ico" />
  </ItemGroup>

  <ItemGroup Condition="'$(BundledPayload)' != ''">
    <EmbeddedResource Include="$(BundledPayload)" LogicalName="payload/BBTAG_IM.dll" WithCulture="false" />
  </ItemGroup>

  <Target Name="BundleWindowLibraries" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <EmbeddedResource Include="@(NativeCopyLocalItems)" Condition="'%(Filename)' == 'libSkiaSharp' Or '%(Filename)' == 'libHarfBuzzSharp'" LogicalName="window/%(Filename)%(Extension)" WithCulture="false" />
    </ItemGroup>
  </Target>

  <Target Name="LeaveBundledLibrariesOutOfPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'libSkiaSharp' Or '%(Filename)' == 'libHarfBuzzSharp' Or '%(Filename)' == 'av_libglesv2'" />
    </ItemGroup>
  </Target>

</Project>
