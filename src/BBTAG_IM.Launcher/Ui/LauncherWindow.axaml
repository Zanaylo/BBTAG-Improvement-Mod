<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:BBTAG_IM.Launcher.Ui"
        xmlns:sys="using:System"
        mc:Ignorable="d"
        d:DesignWidth="820"
        d:DesignHeight="860"
        x:Class="BBTAG_IM.Launcher.Ui.LauncherWindow"
        x:DataType="ui:LauncherViewModel"
        Title="BBTAG Mod Loader"
        Width="820"
        Height="860"
        MinWidth="640"
        MinHeight="560"
        Opened="OnWindowOpened">

  <Design.DataContext>
    <x:Static Member="ui:LauncherDesignData.ViewModel" />
  </Design.DataContext>

  <Window.Styles>
    <Style Selector="Button:disabled PathIcon">
      <Setter Property="Opacity" Value="0.25" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="16,16,16,8" Spacing="6">
      <TextBlock Text="BBTAG Mod Loader" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="{Binding GameText}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding ExecutableText}" TextWrapping="Wrap" />
      <DockPanel Margin="0,8,0,0">
        <Button DockPanel.Dock="Left"
                Content="Play"
                Width="120"
                HorizontalContentAlignment="Center"
                IsEnabled="{Binding CanPlay}"
                Click="OnPlayClick" />
        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Status}" />
      </DockPanel>
    </StackPanel>

    <ListBox x:Name="MessageList"
             DockPanel.Dock="Bottom"
             Height="150"
             Margin="16,8,16,16"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ItemsSource="{Binding Messages}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="sys:String">
          <TextBlock Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TabControl Margin="16,0">
      <TabItem Header="Mods">
        <DockPanel Margin="0,8,0,0">
          <TextBlock DockPanel.Dock="Top"
                     Margin="0,0,0,8"
                     TextWrapping="Wrap"
                     Text="Untick a mod to leave it out of the next game start. Ticked mods load in this order. When two mods replace the same file, the one higher in the list wins. Use the arrows to change the order. A .zip, .rar or .7z in the mods folder is unpacked next to it." />
          <Button DockPanel.Dock="Bottom"
                  Margin="0,8,0,0"
                  HorizontalAlignment="Right"
                  Content="Refresh"
                  ToolTip.Tip="Read the mods folder again, to pick up mods and archives you added, removed or changed."
                  IsEnabled="{Binding CanChangeMods}"
                  Click="OnRefreshModsClick" />
          <ListBox ItemsSource="{Binding Mods}" IsEnabled="{Binding CanChangeMods}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="ui:ModEntry">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button ToolTip.Tip="Move up" AutomationProperties.Name="Move up" IsEnabled="{Binding CanMoveUp}" Click="OnMoveUpClick">
                      <PathIcon Width="12" Height="8" Data="M 0,8 L 6,0 L 12,8 Z" />
                    </Button>
                    <Button ToolTip.Tip="Move down" AutomationProperties.Name="Move down" IsEnabled="{Binding CanMoveDown}" Click="OnMoveDownClick">
                      <PathIcon Width="12" Height="8" Data="M 0,0 L 12,0 L 6,8 Z" />
                    </Button>
                  </StackPanel>
                  <CheckBox IsChecked="{Binding IsEnabled}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Contents}" Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>
                  </CheckBox>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>

      <TabItem Header="Cheat Engine">
        <DockPanel Margin="0,8,0,0">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Spacing="6">
            <TextBlock TextWrapping="Wrap" Text="{Binding ScriptsCaption}" />
            <CheckBox IsVisible="{Binding HasTable}"
                      IsChecked="{Binding ShowCheatEngineWindow}"
                      Content="Show the Cheat Engine window" />
          </StackPanel>
          <Border IsVisible="{Binding HasTable}" BorderBrush="Gray" BorderThickness="1">
            <TreeView ItemsSource="{Binding Scripts}">
              <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="ui:ScriptNode">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
                </Style>
              </TreeView.Styles>
              <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="ui:ScriptNode" ItemsSource="{Binding Children}">
                  <Panel>
                    <CheckBox IsVisible="{Binding CanToggle}"
                              IsEnabled="{Binding !IsRequired}"
                              IsChecked="{Binding IsChecked}"
                              Content="{Binding Label}" />
                    <TextBlock IsVisible="{Binding !CanToggle}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="{Binding Label}" />
                  </Panel>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </Border>
        </DockPanel>
      </TabItem>

      <TabItem Header="Config">
        <StackPanel Margin="0,8,0,0" Spacing="6">
          <CheckBox IsChecked="{Binding WriteLogs}"
                    IsEnabled="{Binding CanChangeMods}"
                    Content="Write log files" />
          <TextBlock TextWrapping="Wrap"
                     Opacity="0.75"
                     Text="Saves what the Mod Loader and the game do in the logs folder, and lists errors from inside the game below. Turn it on to report a problem. Changes the next time you press Play." />
          <CheckBox Margin="0,10,0,0"
                    IsChecked="{Binding PlayOnStart}"
                    IsEnabled="{Binding CanChangeMods}"
                    Content="Press Play when the Mod Loader opens" />
          <TextBlock TextWrapping="Wrap"
                     Opacity="0.75"
                     Text="Starts the game with the ticked mods as soon as the Mod Loader opens, once each time it opens. To change the mods, close the game and change them here." />
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
