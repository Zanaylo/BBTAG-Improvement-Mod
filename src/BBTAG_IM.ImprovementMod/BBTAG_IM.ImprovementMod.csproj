<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BBTAG_IM.ImprovementMod</RootNamespace>
    <AssemblyName>ImprovementMod</AssemblyName>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PlatformTarget>x86</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <SelfContained>true</SelfContained>
    <IlcGenerateStackTraceData>true</IlcGenerateStackTraceData>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BBTAG_IM.Core\BBTAG_IM.Core.csproj" />
    <ProjectReference Include="..\BBTAG_IM.Native\BBTAG_IM.Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(PublicBuild)' != 'true'">
    <Compile Remove="Standalone\**;ImprovementStartup.Standalone.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(PublicBuild)' == 'true'">
    <Compile Remove="Exports.cs;ImprovementStartup.Full.cs;Dev\**;Training\BossFightControl.cs;Training\MatchSetupGate.cs;Training\OwnerlessTakemiGuard.cs;Training\SittingOutSpawnGate.cs;Menu\BossFightPanel.cs;Menu\DevSection.cs;Menu\CommandNamesCombo.cs;Menu\ScriptHelpWindow.cs;Menu\HitboxEditorWindow.cs;Menu\ScriptEditorCombo.cs;Menu\ScriptLanguageChoice.cs;Menu\SpritePreview.cs" />
    <NativeLibrary Include="$(MSBuildProjectDirectory)\$(IntermediateOutputPath)entry_gate.obj" />
  </ItemGroup>

  <Target Name="CompileEntryGate" AfterTargets="SetupOSSpecificProps" Condition="'$(PublicBuild)' == 'true'" Inputs="Standalone\entry_gate.c" Outputs="$(IntermediateOutputPath)entry_gate.obj">
    <Exec Command="&quot;$(_CppToolsDirectory)cl.exe&quot; /nologo /c /O1 /GS- /Zl /Fo&quot;$(IntermediateOutputPath)entry_gate.obj&quot; Standalone\entry_gate.c" />
  </Target>

  <Target Name="BundleMenuLibrary" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <EmbeddedResource Include="@(NativeCopyLocalItems)" Condition="'%(Filename)' == 'cimgui'" LogicalName="%(Filename)%(Extension)" WithCulture="false" />
    </ItemGroup>
  </Target>

  <Target Name="LeaveBundledLibraryOutOfPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'cimgui'" />
    </ItemGroup>
  </Target>

</Project>
