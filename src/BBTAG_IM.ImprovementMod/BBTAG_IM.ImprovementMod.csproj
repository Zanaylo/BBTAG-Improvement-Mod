<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BBTAG_IM.ImprovementMod</RootNamespace>
    <AssemblyName>ImprovementMod</AssemblyName>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PlatformTarget>x86</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <SelfContained>true</SelfContained>
    <IlcGenerateStackTraceData>true</IlcGenerateStackTraceData>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BBTAG_IM.Core\BBTAG_IM.Core.csproj" />
    <ProjectReference Include="..\BBTAG_IM.Native\BBTAG_IM.Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(TesterBuild)' == 'true'">
    <Compile Remove="Dev\PortRunner.cs;Dev\PortPanelFactory.cs;Menu\CharacterPortPanel.cs" />
  </ItemGroup>

  <Target Name="BundleMenuLibrary" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <EmbeddedResource Include="@(NativeCopyLocalItems)" Condition="'%(Filename)' == 'cimgui'" LogicalName="%(Filename)%(Extension)" WithCulture="false" />
    </ItemGroup>
  </Target>

  <Target Name="LeaveBundledLibraryOutOfPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'cimgui'" />
    </ItemGroup>
  </Target>

</Project>
